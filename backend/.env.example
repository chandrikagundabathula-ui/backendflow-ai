# BackendFlow AI Engine - Environment Configuration

# Application Metadata & Runtime Environment
PROJECT_NAME="BackendFlow AI Engine"
VERSION="0.1.0"
ENV="development" # development | production | testing
API_V1_STR="/api"

# Security Configuration
# IMPORTANT: Generate a strong random key for production deployment (e.g. openssl rand -hex 32)
SECRET_KEY="backendflow_secret_key_change_in_production_super_secure_32_bytes_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# AI Provider Configuration
# AI_PROVIDER options: 'gemini' | 'openai' | 'mock'
AI_PROVIDER="mock"
# AI_API_KEY: Your Gemini or OpenAI API Key (Never commit real API keys to repository)
AI_API_KEY=""
# AI_MODEL: Model identifier (e.g., gemini-2.5-flash, gemini-1.5-flash, gpt-4o-mini)
AI_MODEL="gemini-2.5-flash"

# Database Connection URL
# SQLite (Local Dev): sqlite:///./backendflow.db
# PostgreSQL (Production): postgresql://user:password@localhost:5432/backendflow_db
DATABASE_URL="sqlite:///./backendflow.db"

# CORS Configuration (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"
