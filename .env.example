# BackendFlow AI Platform - Environment Variables Template
# Copy this file to .env and configure values before starting services

# === Backend Service Configuration ===
PROJECT_NAME="BackendFlow AI Engine"
VERSION="0.1.0"
ENV="development" # Options: development, production, testing
API_V1_STR="/api"

# JWT Auth Secret Key (Required for production)
SECRET_KEY="production_jwt_secret_key_change_me_to_a_random_secure_hash"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI LLM Provider Configuration
# Set AI_PROVIDER to 'nvidia', 'gemini', 'openai', or 'mock' for offline testing.
AI_PROVIDER="nvidia"
AI_API_KEY="YOUR_API_KEY_HERE"
AI_MODEL="gemini-2.5-flash"

# NVIDIA Build AI Provider Configuration
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY_HERE"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="openai/gpt-oss-20b"

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./backendflow.db"
# DATABASE_URL="postgresql://user:password@host:5432/backendflow_db"

# CORS Configuration for FastAPI
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# === Frontend Next.js Configuration ===
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

