# BackendFlow AI Platform - Environment Variables Template
# Copy this file to .env and configure values before starting services

# === Backend Service Configuration ===
PROJECT_NAME="BackendFlow AI Engine"
VERSION="0.1.0"
ENV="development" # Options: development, production, testing
API_V1_STR="/api"

# JWT Auth Secret Key (Required for production)
SECRET_KEY="production_jwt_secret_key_change_me_to_a_random_secure_hash"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI LLM Provider Configuration
# Set AI_PROVIDER to 'gemini' for Google Gemini, 'openai' for OpenAI, or 'mock' for offline testing.
AI_PROVIDER="gemini"
AI_API_KEY="YOUR_GEMINI_OR_OPENAI_API_KEY_HERE"
AI_MODEL="gemini-2.5-flash"

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./backendflow.db"
# DATABASE_URL="postgresql://postgres:postgres_password@db:5432/backendflow_db"

# CORS Configuration for FastAPI
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"

# === Frontend Next.js Configuration ===
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
